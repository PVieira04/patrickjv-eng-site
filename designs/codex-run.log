x}.tags{margin-top:auto;font-family:'IBM Plex Mono',monospace;font-size:9px;gap:6px}.tags li{border:1px solid var(--rule);padding:3px 7px;color:var(--accent);background:var(--bg)}.side-grid{display:grid;grid-template-columns:1fr 1fr}.side-grid article{padding:25px 26px}.side-grid article+article{border-left:1px solid var(--rule)}.side-grid h3{font-size:18px;letter-spacing:-.02em;margin-bottom:12px}.side-grid p{font-size:13px;color:var(--muted)}.history{display:grid;grid-template-columns:1.25fr 1fr;gap:24px}.experience-item{padding:20px 23px;border-bottom:1px solid var(--rule)}.experience-item:last-child{border-bottom:0}.dates{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--accent);margin-bottom:7px}.experience-item h3{font-size:15px;font-weight:500;line-height:1.5}.org{font-size:12px;color:var(--muted);margin-top:5px}.education-body article{padding:22px 24px;border-bottom:1px solid var(--rule)}.education-body article:last-child{border-bottom:0}.education-body h3{font-size:15px;line-height:1.6;font-weight:500}.education-body p{font-family:'IBM Plex Mono',monospace;color:var(--muted);font-size:11px;margin-top:8px}.skill-list{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--rule)}.skill-list li{background:var(--panel);padding:12px 24px;font-family:'IBM Plex Mono',monospace;font-size:11px;display:flex;align-items:center;gap:12px}.skill-list li::before{content:'+';color:var(--accent)}footer{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px 1px 2px;font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--muted)}footer .social{gap:20px}@media(min-width:1600px){.workspace{padding:40px;gap:32px;grid-template-columns:260px minmax(0,1fr)}.sidebar{top:40px;height:calc(100svh - 80px)}.hero{padding:55px 48px}.hero h1{font-size:90px}}@media(max-width:1100px){.workspace{grid-template-columns:200px minmax(0,1fr);gap:16px;padding:16px}.sidebar{padding:24px 18px;top:16px;height:calc(100svh - 32px)}.sidebar-name{font-size:19px}.hero{padding:30px}.hero-top{flex-direction:column;align-items:flex-start;gap:8px;padding-bottom:28px}.hero .tagline{font-size:18px}.stats dl>div{padding:20px 14px}.stats dd{font-size:26px}.about-copy{padding:24px;gap:20px;grid-template-columns:1fr}.about-copy p:first-child{grid-row:auto;border:0;padding:0}.work-item:first-child{display:block}.work-item:first-child h3{font-size:24px}.work-item{padding:22px}.history{grid-template-columns:1fr;gap:0}}@media(max-width:760px){.workspace{display:block;padding:16px}.sidebar{position:static;height:auto;max-height:none;padding:18px 20px;display:grid;grid-template-columns:1fr auto;align-items:center;margin-bottom:16px;gap:18px}.identity-symbol{width:32px;height:32px;margin:0;grid-column:2;grid-row:1}.sidebar-identity{grid-row:1;grid-column:1}.sidebar-role{font-size:10px;margin-top:5px}.sidebar nav{flex-direction:row;flex-wrap:wrap;grid-column:1/-1;margin:0;gap:10px 22px;font-size:10px}.sidebar nav a{border:0;padding:0;gap:7px}.sidebar-bottom{display:none}.hero h1{font-size:58px}.hero-top{flex-direction:row;align-items:flex-start;font-size:9px;gap:15px}.hero-top .location{max-width:100px;text-align:right}.hero .tagline{font-size:19px}.stats dd{font-size:30px}.stats dl{grid-template-columns:1fr 1fr}.stats dl>div{padding:22px}.stats dl>div:nth-child(2){border-right:0}.stats dl>div:nth-child(-n+2){border-bottom:1px solid var(--rule)}.work-item:first-child h3{font-size:25px}.history{grid-template-columns:1fr 1fr;gap:16px}.panel{margin-top:16px}.history .panel-head{padding:14px 16px}.education-body article,.experience-item{padding:20px 16px}.skill-list li{padding:12px 18px;font-size:10px}}@media(max-width:520px){.workspace{padding:12px}.sidebar{padding:16px}.sidebar nav{gap:10px 18px}.hero{padding:28px 23px}.hero h1{font-size:52px;max-width:320px}.hero-top{padding-bottom:30px}.hero-top>p:first-child{max-width:150px}.hero .tagline{font-size:18px}.hero .social{padding-top:18px;margin-top:25px}.stats dl>div{padding: