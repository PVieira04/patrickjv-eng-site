}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body {
  margin: 0;
  background-color: var(--bg);
  background-image:
    linear-gradient(to right, var(--grid) 1px, transparent 1px),
    linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
  background-size: 32px 32px;
  color: var(--ink);
  font-family: var(--sans);
  font-size: 1.0625rem;
  line-height: 1.6;
  overflow-x: hidden;
}
a { color: inherit; text-decoration-color: var(--line-strong); text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
a:hover { color: var(--signal); text-decoration-color: currentColor; }
:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; border-radius: 1px; }
::selection { background: var(--signal); color: var(--signal-ink); }

.skip {
  position: absolute; left: var(--gutter); top: -100px;
  background: var(--signal); color: var(--signal-ink);
  font-family: var(--mono); font-size: 0.8125rem; padding: 0.5rem 0.75rem; z-index: 10;
}
.skip:focus { top: 12px; }

.sheet {
  max-width: 1160px;
  margin: 0 auto;
  border-left: 1px solid var(--line);
  border-right: 1px solid var(--line);
  background: color-mix(in srgb, var(--bg) 82%, transparent);
}

.mono, .label, .meta { font-family: var(--mono); }
.label {
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}
.label b { color: var(--signal); font-weight: 500; }

/* ---------- Title block ---------- */
.masthead { border-bottom: 1px solid var(--line); }
.strip {
  display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem;
  padding: 0.75rem var(--gutter);
  border-bottom: 1px solid var(--line);
}
.strip nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
.strip nav a { text-decoration: none; }
.strip nav a:hover { color: var(--signal); }

.hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) clamp(15rem, 28vw, 20rem);
  align-items: start;
  padding: clamp(2.5rem, 7vw, 5.5rem) var(--gutter) clamp(2rem, 5vw, 3.5rem);
  gap: 2rem;
}
.hero h1 {
  margin: 0.75rem 0 0;
  font-weight: 500;
  font-size: clamp(2.5rem, 8vw, 5rem);
  line-height: 1.02;
  letter-spacing: -0.025em;
}
.hero .role {
  margin: 0.9rem 0 0;
  font-family: var(--mono);
  font-size: clamp(0.9375rem, 2vw, 1.0625rem);
  color: var(--signal);
}
.hero .tagline {
  margin: 1.75rem 0 0;
  max-width: 38ch;
  font-size: clamp(1.25rem, 2.6vw, 1.625rem);
  line-height: 1.4;
  font-weight: 400;
}

/* Hero actions */
.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 2rem 0 0; padding: 0; list-style: none; }
.btn {
  display: inline-flex; align-items: center; gap: 0.6rem;
  min-height: 2.75rem; padding: 0.6rem 1.15rem;
  font-family: var(--mono); font-size: 0.9375rem; font-weight: 500; letter-spacing: 0.02em;
  text-decoration: none;
  border: 1px solid var(--signal);
}
.btn svg { width: 1.05rem; height: 1.05rem; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.btn-solid { background: var(--signal); color: var(--signal-ink); }
.btn-solid:hover { background: transparent; color: var(--signal); }
.btn-line { background: transparent; color: var(--ink); border-color: var(--line-strong); }
.btn-line:hover { border-color: var(--signal); color: var(--signal); }
.btn:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }

/* Plate (portrait) */
.plate { margin: 0; justify-self: end; width: 100%; }
.plate-frame {
  --tick: var(--signal);
  padding: 10px;
  background:
    linear-gradient(var(--tick), var(--tick)) left top / 12px 1px no-repeat,
    linear-gradient(var(--tick), var(--tick)) left top / 1px 12px no-repeat,
    linear-gradient(var(--tick), var(--tick)) right top / 12px 1px no-repeat,
    linear-gradient(var(--tick), var(--tick)) right top / 1px 12px no-repeat,
    linear-gradient(var(--tick), var(--tick)) left bottom / 12px 1px no-repeat,
    linear-gradient(var(--tick), var(--tick)) left bottom / 1px 12px no-repeat,
    linear-gradient(var(--tick), var(--tick)) right bottom / 12px 1px no-repeat,
    linear-gradient(var(--tick), var(--tick)) right bottom / 1px 12px no-repeat;
}
.plate-img {
  position: relative;
  aspect-ratio: 1 / 1;
  border: 1px solid var(--line-strong);
  overflow: hidden;
}
/* Neutral fill shown when the photo is absent: panel tone with a faint drafting cross. */
.plate-img, .plate-img img::after {
  background:
    linear-gradient(to top right, transparent calc(50% - 0.5px), var(--line) 50%, transparent calc(50% + 0.5px)),
    linear-gradient(to bottom right, transparent calc(50% - 0.5px), var(--line) 50%, transparent calc(50% + 0.5px)),
    var(--panel);
}
.plate-img img {
  position: relative;
  display: block;
  width: 100%; height: 100%;
  object-fit: cover;
  color: transparent; /* hide alt text if the file is missing */
}
/* A broken image is not a replaced element, so this pseudo-element only paints when
   the file fails to load — it covers the browser's broken-image icon with the fill. */
.plate-img img::after { content: ""; position: absolute; inset: 0; }
.plate figcaption { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.6rem; padding: 0 10px; }

.spec {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-top: 1px solid var(--line);
}
.spec > div {
  padding: 0.9rem var(--gutter);
  border-right: 1px solid var(--line);
  min-width: 0;
}
.spec > div:last-child { border-right: 0; }
.spec dt { margin: 0; }
.spec dd { margin: 0.25rem 0 0; font-family: var(--mono); font-size: 0.9375rem; overflow-wrap: anywhere; }

/* ---------- Sections ---------- */
section { border-bottom: 1px solid var(--line); }
.row {
  display: grid;
  grid-template-columns: var(--label-col) minmax(0, 1fr);
}
.row > .head {
  padding: 2.25rem var(--gutter);
  border-right: 1px solid var(--line);
}
.row > .body {
  padding: 2.25rem var(--gutter);
  min-width: 0;
}
.head h2 {
  margin: 0.5rem 0 0;
  font-size: 1.125rem;
  font-weight: 500;
  letter-spacing: -0.005em;
}
.head .idx { display: block; }

.about p, .prose p { margin: 0 0 1.1rem; max-width: 68ch; }
.about p:last-child, .prose p:last-child { margin-bottom: 0; }
.about p:first-child { font-size: 1.1875rem; line-height: 1.55; }

/* Readouts */
.readouts {
  list-style: none; margin: 0; padding: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border: 1px solid var(--line);
  background: var(--panel);
}
.readouts li {
  padding: 1.25rem 1.25rem 1.4rem;
  border-right: 1px solid var(--line);
  position: relative;
  min-width: 0;
}
.readouts li:last-child { border-right: 0; }
.readouts li::before {
  content: ""; position: absolute; left: 1.25rem; top: 0; width: 1.5rem; height: 2px; background: var(--signal);
}
.readouts .value {
  display: block;
  font-family: var(--mono);
  font-weight: 500;
  font-size: clamp(1.75rem, 3.4vw, 2.375rem);
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin-top: 0.6rem;
}
.readouts .rlabel { display: block; margin-top: 0.6rem; color: var(--muted); font-size: 0.9375rem; line-height: 1.45; }

/* Diagram */
.diagram { margin: 0 0 1.75rem; border: 1px solid var(--line); background: var(--panel); padding: 1rem 1.25rem 0.75rem; }
.diagram svg { display: block; width: 100%; height: auto; }
.diagram .cap { margin-top: 0.5rem; }
.d-line { stroke: var(--line-strong); stroke-width: 1; fill: none; }
.d-bus { stroke: var(--signal); stroke-width: 1.5; }
.d-box { fill: var(--bg); stroke: var(--line-strong); stroke-width: 1; }
.d-core { fill: var(--signal-soft); stroke: var(--signal); stroke-width: 1; }
.d-txt { font-family: var(--mono); font-size: 11px; fill: var(--muted); letter-spacing: 0.06em; }
.d-txt-core { font-family: var(--mono); font-size: 11px; fill: var(--signal); letter-spacing: 0.06em; }
.d-dot { fill: var(--signal); }

/* Components */
.components {
  list-style: none; margin: 0; padding: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}
.component {
  position: relative;
  border: 1px solid var(--line);
  background: var(--panel);
  display: flex; flex-direction: column;
  height: 100%;
}
.component:hover { border-color: var(--line-strong); }
.component::before, .component::after {
  content: ""; position: absolute; width: 7px; height: 7px;
  border: 1px solid var(--signal); background: var(--bg);
  top: -4px;
}
.component::before { left: 18px; }
.component::after { right: 18px; }
.c-head {
  display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
  padding: 0.85rem 1.25rem;
  border-bottom: 1px solid var(--line);
}
.c-id { color: var(--signal); }
.c-body { padding: 1.1rem 1.25rem 1.25rem; flex: 1; }
.c-body h3 { margin: 0; font-size: 1.1875rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
.c-body p { margin: 0.7rem 0 0; color: var(--ink); font-size: 1rem; line-height: 1.6; }
.c-meta {
  display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.75rem; align-items: start;
  padding: 0.85rem 1.25rem;
  border-top: 1px dashed var(--line);
}
.c-meta dt { padding-top: 0.2rem; }
.c-meta dd { margin: 0; }
.tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
.tags li {
  font-family: var(--mono); font-size: 0.8125rem; line-height: 1.3;
  padding: 0.2rem 0.5rem;
  border: 1px solid var(--line-strong);
  color: var(--ink);
}

/* Side projects */
.aux { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
.aux li { border-left: 2px solid var(--signal); padding: 0.25rem 0 0.25rem 1.1rem; }
.aux h3 { margin: 0.35rem 0 0; font-size: 1.0625rem; font-weight: 600; }
.aux p { margin: 0.45rem 0 0; color: var(--muted); }

/* Skills */
.skills { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
.skills li { padding: 0.75rem 1rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; gap: 0.75rem; align-items: baseline; font-size: 0.9875rem; }
.skills li span { font-family: var(--mono); font-size: 0.75rem; color: var(--signal); }

/* Quick answers */
.faq { margin: 0; border-top: 1px solid var(--line); }
.faq > div { padding: 1.1rem 0 1.2rem; border-bottom: 1px solid var(--line); }
.faq h3 { margin: 0; font-family: var(--mono); font-size: 0.9875rem; font-weight: 500; line-height: 1.45; color: var(--ink); }
.faq .q-id { color: var(--signal); }
.faq .q-id + h3 { margin-top: 0.35rem; }
.faq p { margin: 0.5rem 0 0; max-width: 68ch; font-family: var(--sans); }

/* Footer */
footer { padding: 1.5rem var(--gutter) 2rem; }
.foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 2rem; align-items: baseline; }
.foot ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
.foot a { font-family: var(--mono); font-size: 0.9375rem; }

/* ---------- Responsive ---------- */
@media (max-width: 960px) {
  .readouts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .readouts li:nth-child(2) { border-right: 0; }
