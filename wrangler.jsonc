{
  // Static assets only, no Worker script: asset requests are free and unmetered on the
  // Free plan, so the site and /.well-known/did.json can't be taken down by request quota.
  "name": "patrickjv-eng-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "./public" }
}
