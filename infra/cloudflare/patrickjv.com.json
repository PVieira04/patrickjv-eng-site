  "rulesets": {
    "http_ratelimit": [
      {
        "description": "MCP flood guard",
        "expression": "(starts_with(http.request.uri.path, \"/mcp\"))",
        "action": "block",
        "ratelimit": {
          "characteristics": [
            "ip.src",
            "cf.colo.id"
          ],
          "mitigation_timeout": 10,
          "period": 10,
          "requests_per_period": 6
        },
        "enabled": true
      }
    ],
    "http_request_dynamic_redirect": [
      {
        "description": "Alias -> patrickjv.com (GET/HEAD 301)",
        "expression": "(http.host in {\"www.patrickjv.com\" \"www.patrickjv.com.\"} and http.request.method in {\"GET\" \"HEAD\"})",
        "action": "redirect",
        "action_parameters": {
          "from_value": {
            "preserve_query_string": true,
            "status_code": 301,
            "target_url": {
              "expression": "concat(\"https://patrickjv.com\", http.request.uri.path)"
            }
          }
        },
        "enabled": true
      },
      {
        "description": "Alias -> patrickjv.com (other methods 308)",
        "expression": "(http.host in {\"www.patrickjv.com\" \"www.patrickjv.com.\"} and not http.request.method in {\"GET\" \"HEAD\"})",
        "action": "redirect",
        "action_parameters": {
          "from_value": {
            "preserve_query_string": true,
            "status_code": 308,
            "target_url": {
              "expression": "concat(\"https://patrickjv.com\", http.request.uri.path)"
            }
          }
        },
        "enabled": true
      }
    ],
    "http_request_transform": [
      {
        "description": "Markdown for agents",
        "expression": "(http.request.uri.path eq \"/\" and any(starts_with(http.request.headers[\"accept\"][*], \"text/markdown\")))",
        "action": "rewrite",
        "action_parameters": {
          "uri": {
            "path": {
              "value": "/index.md"
            }
          }
        },
        "enabled": true
      }
    ]
  },
