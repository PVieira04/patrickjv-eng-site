{
  // Deployed by Cloudflare Workers Builds on push to main (build: npm ci && npm test).
  // Remote MCP server. Runs ONLY on patrickjv.com/mcp*; the rest of the site stays on the
  // assets-only patrickjv-eng-site Worker, so ordinary page views never invoke code.
  "name": "patrickjv-mcp",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "patrickjv.com/mcp*", "zone_name": "patrickjv.com" }],
  // Workers Logs: ONLY the handler's own console events (redacted failure and quota-refusal events:
  // subsystem or cap name, no personal data). Invocation logs are off: they would record every
  // request's metadata (client IP, location, user agent) for the log retention period.
  // redact_query_string stays as a second line of defence for any request URL that is logged.
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
  "vars": { "INTRO_FROM": "intro@patrickjv.com" },
  // Secret, not a var: INTRO_TO_ADDRESS, the verified mailbox introductions are delivered to (kept
  // out of this public repo). Set with `wrangler secret put INTRO_TO_ADDRESS -c mcp/wrangler.jsonc`.
  // Secret, not a var: QUOTA_SALT keys the HMAC of the IP and sender keys held by IntroQuota.
  // Set with `wrangler secret put QUOTA_SALT -c mcp/wrangler.jsonc` (a random value of at least 32
  // characters); without it request_intro is refused (fail closed) and read tools carry on.
  // Email Routing send_email can only deliver to the account's verified destination addresses
  // (free plan), so strangers can never use it to email anyone else. No destination_address here:
  // the address stays out of the repo, and the handler sends to INTRO_TO_ADDRESS only.
  "send_email": [{ "name": "EMAIL" }],
  // Atomic daily quota for request_intro (SQLite-backed Durable Objects are on the Free plan).
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "IntroQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IntroQuota"] }],
  // Per-client limits (IPv4 address or IPv6 /64), counted per Cloudflare location.
  // An MCP session is ~4 requests: initialize, initialized, tools/list, tools/call. RL_MCP counts
  // every request; RL_BURST counts only tools/call and other real work, so a handshake never uses
  // up the burst allowance of a shared egress address (e.g. a hosted MCP client). The edge WAF
  // rule (6 / 10 s per IP) still bounds everything before the Worker runs.
  "ratelimits": [
    { "name": "RL_BURST", "namespace_id": "4103", "simple": { "limit": 10, "period": 10 } },
    { "name": "RL_MCP", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_INTRO", "namespace_id": "4102", "simple": { "limit": 1, "period": 60 } }
  ]
}
